    <select id="getBaselineList" resultMap="baselineMap">
        SELECT
            b.`id`,
            b.`app_system_id`,
            b.`app_module_id`,
            b.`env_id`,
            b.`type_id`,
            b.`schema_name`,
            b.`scope_hash`,
            b.`name`,
            b.`description`,
            b.`current_version_id`,
            b.`fcd`,
            b.`fcu`,
            b.`lcd`,
            b.`lcu`,
            v.`version` AS `current_version`,
            v.`status` AS `current_status`,
            v.`field_count` AS `current_field_count`,
            COALESCE(v.`approved_time`, v.`lcd`, v.`fcd`) AS `current_approved_time`,
            COALESCE(v.`lcu`, v.`fcu`) AS `current_publisher`,
            v.`source_snapshot_id` AS `current_source_snapshot_id`
        FROM `inspect_config_baseline` b
        LEFT JOIN `inspect_config_baseline_version` v ON b.`current_version_id` = v.`id`
        <where>
            <if test="appSystemId != null">
                AND b.`app_system_id` = #{appSystemId}
            </if>
            <if test="appModuleId != null">
                AND b.`app_module_id` = #{appModuleId}
            </if>
            <if test="envId != null">
                AND b.`env_id` = #{envId}
            </if>
            <if test="schemaName != null and schemaName != ''">
                AND b.`schema_name` = #{schemaName}
            </if>
        </where>
        ORDER BY b.`type_id` ASC, b.`lcd` DESC
    </select>

    <select id="getBaselineByScopeHash" parameterType="java.lang.String" resultMap="baselineMap">
