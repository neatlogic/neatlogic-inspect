    <select id="getBaselineVersionById" parameterType="java.lang.Long" resultMap="baselineVersionMap">
        SELECT
            v.`id`,
            v.`baseline_id`,
            v.`version`,
            v.`status`,
            v.`is_frozen`,
            v.`source_type`,
            v.`source_snapshot_id`,
            COALESCE(v.`source_resource_id`, s.`resource_id`) AS `source_resource_id`,
            v.`field_count`,
            v.`baseline_data`,
            v.`ai_candidate_data`,
            v.`change_summary`,
            v.`change_log`,
            v.`submitter`,
            v.`submit_time`,
            v.`approved_time`,
            v.`activated_time`,
            CASE WHEN b.`current_version_id` = v.`id` THEN 1 ELSE 0 END AS `is_current_active`,
            v.`approval_status`,
            v.`approver`,
            v.`approval_comment`,
            v.`fcd`,
            v.`fcu`,
            v.`lcd`,
            v.`lcu`
        FROM `inspect_config_baseline_version` v
        LEFT JOIN `inspect_config_baseline` b ON b.`id` = v.`baseline_id`
        LEFT JOIN `inspect_config_snapshot` s ON s.`id` = v.`source_snapshot_id`
        WHERE v.`id` = #{id}
    </select>

