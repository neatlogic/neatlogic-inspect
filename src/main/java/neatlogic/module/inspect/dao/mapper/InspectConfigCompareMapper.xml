            b.`lcu`,
            v.`version` AS `current_version`,
            v.`status` AS `current_status`,
            v.`field_count` AS `current_field_count`,
            COALESCE(v.`approved_time`, v.`lcd`, v.`fcd`) AS `current_approved_time`,
            COALESCE(v.`lcu`, v.`fcu`) AS `current_publisher`,
            v.`source_snapshot_id` AS `current_source_snapshot_id`
        FROM `inspect_config_baseline` b
        LEFT JOIN `inspect_config_baseline_version` v ON b.`current_version_id` = v.`id`
        WHERE b.`scope_hash` = #{scopeHash}
    </select>

