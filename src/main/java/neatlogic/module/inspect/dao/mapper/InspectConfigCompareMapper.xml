    <insert id="insertSnapshot" parameterType="neatlogic.module.inspect.dto.InspectConfigSnapshotVo">
        INSERT INTO `inspect_config_snapshot` (
            `id`, `app_system_id`, `app_module_id`, `env_id`, `resource_id`, `type_id`, `job_id`, `schema_name`,
            `schema_version`, `source`, `status`, `collect_time`, `config_file_audit_id`, `raw_data`,
            `normalized_data`, `ai_candidate_data`, `ai_draft_data`, `summary`, `fcd`, `fcu`, `lcd`, `lcu`
        ) VALUES (
            #{id}, #{appSystemId}, #{appModuleId}, #{envId}, #{resourceId}, #{typeId}, #{jobId}, #{schemaName},
            #{schemaVersion}, #{source}, #{status}, #{collectTime}, #{configFileAuditId}, #{rawData},
            #{normalizedData}, #{aiCandidateData}, #{aiDraftData}, #{summary}, NOW(3), #{fcu}, NOW(3), #{lcu}
        )
    </insert>

    <update id="updateSnapshotAiData" parameterType="neatlogic.module.inspect.dto.InspectConfigSnapshotVo">
        UPDATE `inspect_config_snapshot`
        SET `ai_candidate_data` = #{aiCandidateData},
            `ai_draft_data` = #{aiDraftData},
            `lcd` = NOW(3),
            `lcu` = #{lcu}
        WHERE `id` = #{id}
    </update>

    <insert id="insertCompareTask" parameterType="neatlogic.module.inspect.dto.InspectConfigCompareTaskVo">
        INSERT INTO `inspect_config_compare_task` (
            `id`, `compare_type`, `baseline_version_id`, `source_snapshot_id`, `target_snapshot_id`, `app_system_id`,
            `app_module_id`, `env_id`, `status`, `compare_result`, `risk_level`, `is_blocked`, `total_count`,
            `diff_count`, `high_count`, `medium_count`, `low_count`, `summary`, `ai_summary`, `fcd`, `fcu`, `lcd`, `lcu`
        ) VALUES (
            #{id}, #{compareType}, #{baselineVersionId}, #{sourceSnapshotId}, #{targetSnapshotId}, #{appSystemId},
            #{appModuleId}, #{envId}, #{status}, #{compareResult}, #{riskLevel}, #{isBlocked}, #{totalCount},
            #{diffCount}, #{highCount}, #{mediumCount}, #{lowCount}, #{summary}, #{aiSummary}, NOW(3), #{fcu}, NOW(3), #{lcu}
        )
    </insert>

    <update id="updateCompareTask" parameterType="neatlogic.module.inspect.dto.InspectConfigCompareTaskVo">
        UPDATE `inspect_config_compare_task`
        SET `status` = #{status},
            `compare_result` = #{compareResult},
            `risk_level` = #{riskLevel},
            `is_blocked` = #{isBlocked},
            `total_count` = #{totalCount},
            `diff_count` = #{diffCount},
            `high_count` = #{highCount},
            `medium_count` = #{mediumCount},
            `low_count` = #{lowCount},
            `summary` = #{summary},
            `ai_summary` = #{aiSummary},
            `lcd` = NOW(3),
            `lcu` = #{lcu}
        WHERE `id` = #{id}
    </update>

    <select id="getCompareTaskById" parameterType="java.lang.Long" resultMap="compareTaskMap">
        SELECT
            `id`, `compare_type`, `baseline_version_id`, `source_snapshot_id`, `target_snapshot_id`, `app_system_id`,
            `app_module_id`, `env_id`, `status`, `compare_result`, `risk_level`, `is_blocked`, `total_count`,
            `diff_count`, `high_count`, `medium_count`, `low_count`, `summary`, `ai_summary`, `fcd`, `fcu`, `lcd`, `lcu`
        FROM `inspect_config_compare_task`
        WHERE `id` = #{id}
    </select>

    <select id="getLatestCompareTask" resultMap="compareTaskMap">
        SELECT
            `id`, `compare_type`, `baseline_version_id`, `source_snapshot_id`, `target_snapshot_id`, `app_system_id`,
            `app_module_id`, `env_id`, `status`, `compare_result`, `risk_level`, `is_blocked`, `total_count`,
            `diff_count`, `high_count`, `medium_count`, `low_count`, `summary`, `ai_summary`, `fcd`, `fcu`, `lcd`, `lcu`
        FROM `inspect_config_compare_task`
        WHERE `compare_type` = #{compareType}
          AND `source_snapshot_id` = #{sourceSnapshotId}
          <choose>
              <when test="baselineVersionId != null">
                  AND `baseline_version_id` = #{baselineVersionId}
              </when>
              <otherwise>
                  AND `baseline_version_id` IS NULL
              </otherwise>
          </choose>
          <choose>
              <when test="targetSnapshotId != null">
                  AND `target_snapshot_id` = #{targetSnapshotId}
              </when>
              <otherwise>
                  AND `target_snapshot_id` IS NULL
              </otherwise>
          </choose>
        ORDER BY `fcd` DESC, `id` DESC
        LIMIT 1
    </select>

    <insert id="insertCompareDetail" parameterType="neatlogic.module.inspect.dto.InspectConfigCompareDetailVo">
        INSERT INTO `inspect_config_compare_detail` (
            `id`, `task_id`, `layer`, `path`, `label`, `compare_mode`, `status`, `risk_level`,
            `is_blocked`, `reason`, `source_value`, `target_value`, `ai_analysis`, `ai_status`,
            `ai_retry_count`, `ai_next_retry_time`, `ai_last_error`, `sort`
        ) VALUES (
            #{id}, #{taskId}, #{layer}, #{path}, #{label}, #{compareMode}, #{status}, #{riskLevel},
            #{isBlocked}, #{reason}, #{sourceValue}, #{targetValue}, #{aiAnalysis}, #{aiStatus},
            #{aiRetryCount}, #{aiNextRetryTime}, #{aiLastError}, #{sort}
        )
    </insert>

    <select id="getCompareDetailListByTaskId" parameterType="java.lang.Long" resultMap="compareDetailMap">
        SELECT
            `id`, `task_id`, `layer`, `path`, `label`, `compare_mode`, `status`, `risk_level`,
            `is_blocked`, `reason`, `source_value`, `target_value`, `ai_analysis`, `ai_status`,
            `ai_retry_count`, `ai_next_retry_time`, `ai_last_error`, `sort`
        FROM `inspect_config_compare_detail`
        WHERE `task_id` = #{taskId}
        ORDER BY `sort` ASC, `id` ASC
    </select>

    <select id="getCompareDetailListByIdList" resultMap="compareDetailMap">
        SELECT
            `id`, `task_id`, `layer`, `path`, `label`, `compare_mode`, `status`, `risk_level`,
            `is_blocked`, `reason`, `source_value`, `target_value`, `ai_analysis`, `ai_status`,
            `ai_retry_count`, `ai_next_retry_time`, `ai_last_error`, `sort`
        FROM `inspect_config_compare_detail`
        WHERE `id` IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY `sort` ASC, `id` ASC
    </select>

    <update id="updateCompareDetailAiInfo" parameterType="neatlogic.module.inspect.dto.InspectConfigCompareDetailVo">
        UPDATE `inspect_config_compare_detail`
        SET `ai_analysis` = #{aiAnalysis},
            `ai_status` = #{aiStatus},
            `ai_retry_count` = #{aiRetryCount},
            `ai_next_retry_time` = #{aiNextRetryTime},
            `ai_last_error` = #{aiLastError}
        WHERE `id` = #{id}
    </update>
</mapper>
